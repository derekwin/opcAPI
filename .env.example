SERVICE_NAME=opcapi
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

REQUIRE_API_KEY=true
API_KEYS=sk-opcapi-dev
REQUEST_RPM_LIMIT=120
DAILY_TOKEN_LIMIT=1000000
POLICY_BACKEND=file
POLICY_STORE_PATH=data/policies.json
POLICY_REFRESH_INTERVAL=30s

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POLICY_KEY=opcapi:policies:v1
REDIS_QUOTA_PREFIX=opcapi:quota
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

USER_STORE_PATH=data/users.json
BILLING_STORE_PATH=data/billing.json
PROMPT_API_STORE_PATH=data/prompt_apis.json
AUDIT_STORE_PATH=data/audit_logs.json
UPSTREAM_STORE_PATH=data/upstreams.json
SESSION_SECRET=opcapi-dev-session-secret
SESSION_TTL=168h

PROVIDER_TIMEOUT=60s
DEFAULT_PROVIDER=stub
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
